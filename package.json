{
  "name": "hl-paper-scanner",
  "version": "2.0.0",
  "type": "module",
  "description": "Hyperliquid Funding Arbitrage — Paper & Production Trading",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:paper": "TRADING_MODE=PAPER node src/index.js",
    "start:prod": "TRADING_MODE=PRODUCTION node src/index.js",
    "dev:dash": "vite",
    "build:dash": "vite build",
    "preview:dash": "vite preview",
    "test": "NODE_ENV=test node --test tests/*.test.js",
    "tui": "node tools/tui.js",
    "tui:remote": "node tools/tui.js --url $DASHBOARD_URL"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^5.2.1",
    "hyperliquid": "^1.0.0",
    "node-cron": "^4.2.1",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "lightweight-charts": "^4.2.0",
    "vite": "^8.0.16"
  }
}
