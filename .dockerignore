# Зависимости ставятся внутри образа (npm ci) — host-node_modules могут быть
# под другую архитектуру (darwin) и сломать native-биндинги (better-sqlite3).
node_modules

# Vite-сборка генерится в build-stage, не тащим хостовую
src/modules/dashboard/dist

# Секреты и мусор
.env
.git
*.log
logs/*.log

# 🚨 data/ и logs/ — bind-mount тома во всех сервисах: в образе они мёртвый
# груз (на проде это ~1 ГБ в каждом слое), а в рантайме всё равно перекрыты.
data
logs

# Разработка: в рантайме не грузится ничего из этого.
# 🚨 tools/ НЕ исключать — из него импортируют dashboard/server и fvgAlerts.
tests
docs
# 🚨 файл заморозки читают витрина, winnersWatch и крон tools/winners.mjs.
!docs/winners-preregistration.json
.claude
.github
*.md
.vscode
.eslintrc*
eslint.config.js
