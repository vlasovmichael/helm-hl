# ── Режим торговли ──────────────────────────────
TRADING_MODE=PAPER            # PAPER или PRODUCTION

# ── Кошелёк ─────────────────────────────────────
PUBLIC_WALLET_ADDRESS=0xYourWalletAddress
HL_PRIVATE_KEY=               # обязателен только для PRODUCTION

# ── RPC (Base mainnet) ───────────────────────────
RPC_URL=https://mainnet.base.org

# ── Торговые параметры ───────────────────────────
MIN_APY_THRESHOLD=30          # выходим ниже этого APY
ENTRY_APY_THRESHOLD=60        # заходим только выше этого APY
LEVERAGE=1                    # кредитное плечо (1 = без плеча)

# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Логирование ──────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
