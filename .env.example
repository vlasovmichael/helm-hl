# ── Кошелёк ─────────────────────────────────────
PUBLIC_WALLET_ADDRESS=0xYourWalletAddress
HL_AGENT_PRIVATE_KEY=         # ключ Agent Wallet (рекомендуется для PRODUCTION)
HL_PRIVATE_KEY=               # основной ключ (fallback, НЕ рекомендуется)

# ── Торговые параметры ───────────────────────────
FAKE_BALANCE=                 # виртуальный баланс для PAPER (пустой = реальный withdrawable)
COIN_BLACKLIST=STBL           # неторгуемые тикеры через запятую (HLP-индексы и т.п.)
#MIN_APY_THRESHOLD=           # (override) выходим ниже этого APY
#ENTRY_APY_THRESHOLD=         # (override) заходим только выше этого APY
LEVERAGE=1                    # кредитное плечо (1 = без плеча)

# ── Strategy constants ───────────────────────────
# Shared by carry and fade strategies. Tune carefully — these are the core risk knobs.
ROUND_TRIP=0.001              # round-trip cost (entry+exit). 0.1% = conservative, 0.06% = tight for liquid top-50

# ── Liquidity whitelist (Scout) ──────────────────
MIN_VOLUME_USD=1000000               # порог 24h-оборота для попадания в скан ($)
# Scout берёт только монеты из top-N по dayNtlVlm с минимальным объёмом.
# Кеш whitelist-а — раз в N часов, чтобы сам список не дёргался.
LIQUID_TOP_N=50               # размер whitelist (top-N по 24h volume)
LIQUID_MIN_VOLUME=10000000    # $10M/24h — hard floor до top-N фильтра
LIQUID_CACHE_HOURS=6          # TTL кеша whitelist-а

# ── Setup Scanner (manual-helper, не торговая логика) ──
# Scout раз в N минут пишет snapshot (funding/OI/premium/vol) по liquidSet
# в setup_snapshots → дашборд показывает конвергенцию сигналов. Retention 90 дней.
SETUP_SNAPSHOT_INTERVAL_MIN=60

# ── Market Regime — защита carry-входов от тренда ──
# Iter A (per-coin velocity): не шортим монету которая выросла >X% за N мин (и зеркально для long).
# Iter B (BTC regime): глобальный гейт — если BTC pumpнул >pct → блок short-входов; dump → блок long.
# Оба под флагами, default OFF — на проде оба true.
MARKET_REGIME_VELOCITY_ENABLED=true
MARKET_REGIME_BTC_ENABLED=true

# ── Тренд по EMA (витрина Screen: HTF-тренд монеты) ──────────────────────
# ⚠️ НЕ торговая стратегия: радар сетапов для РУЧНОЙ торговли (бот НИКОГДА не
# входит). План: memory/candy_girl_idea.md. Подсвечивает «1h-тренд по EMA20/200
# + откат к 5m EMA20 + reclaim» и шлёт TG-алерт, чтобы оператор собрал ручные сделки.
#                                      # Accumulation profile: радар + paper shadow-слот копят данные (prod-путь не построен). Видно в таблице /strategies.
TREND_LOOKBACK_MIN=15                 # окно тренда витрины, мин
TREND_EMA_FAST_1H=20                  # быстрая EMA на 1h (тренд)
TREND_EMA_SLOW_1H=200                 # медленная EMA на 1h (тренд + наклон)
TREND_SLOPE_LOOKBACK=10           # за сколько 1h-свечей мерить наклон EMA200
# ── Риск на сделку ──────────────────────────────────────────────────────────
# Процент депо, которым готов рискнуть в одной сделке. Единственная величина,
# которая переносится между счетами: 5% = $0.21 на депо $4 и $1000 на $20 000.
# Размер позиции из неё выводится: нотионал = депо × RISK_PCT / дистанция стопа.
# Бот размер не навязывает (вход ручной) — считает и говорит, когда превышено.
ADOPT_RISK_PCT=5                     # (0, 100)

# ── Цель (TP) на бирже при подхвате ─────────────────────────────────────────
# Reduce-only лимитка ставится вместе со стопом и висит в книге: исполняется
# мейкером, без участия бота. Дистанция = RR × дистанция стопа (стоп уже по ATR),
# иначе в зажатых случаях заявленный R:R разъезжается с фактическим.
# RR=1 → breakeven-winrate 50%; RR=0.5 → 67%; RR=0.33 → 75%. Меньше цель —
# выше winrate и приятнее лог, но выше и планка, которую надо перебить.
ADOPT_TP_ENABLED=true
ADOPT_TP_RR=1                        # целевой R:R; (0, 10]
ADOPT_TP_MAX_PCT=15                  # потолок дистанции цели, % от входа; (0, 50)

# ── Выход лимиткой (post-only) вместо маркета ────────────────────────────────
# 1440 из 1440 закрытий уходили тейкером при медиане спреда ~16 бп. Теперь бот
# сначала кладёт reduce-only Alo на свою сторону книги, ждёт, и только потом
# добивает маркетом. Фолбэк не отключается: выход должен состояться.
CLOSE_LIMIT_ENABLED=true             # false → старое поведение (сразу маркет)
CLOSE_LIMIT_WAIT_MS=20000            # сколько ждём налива мейкером; [1000, 300000]
CLOSE_LIMIT_POLL_MS=2000             # шаг опроса остатка позиции; [250, WAIT_MS]

ADOPT_ENABLED=false                  # master flag (ставит ЖИВЫЕ ордера на счёт)
ADOPT_MAX_AGE_MIN=360                # не подхватывать orphan старше N мин (6ч: ловит ручные входы, отсекает древние забытые ноги)
# Жёсткий стоп на бирже: ATR подстраивает дистанцию под волатильность монеты
# (фейдеру нужен воздух), фикс-% — простой фолбэк. dist = ATR(1h,14)×MULT, зажат
# в [MIN,MAX]. Если свечей/ATR нет — падаем на ADOPT_STOP_PCT.
ADOPT_STOP_MODE=atr                  # atr | pct
ADOPT_ATR_MULT=1.5                   # множитель ATR (1.5 = ~полтора обычных размаха)
ADOPT_STOP_MIN_PCT=2                 # зажим снизу (не уже шума); (0, MAX)
ADOPT_STOP_MAX_PCT=8                 # зажим сверху (катастрофа-тормоз); < 20
ADOPT_STOP_PCT=5                     # фикс-% (режим pct + фолбэк когда ATR нет); (0,20)
# Сопровождение (per-tick поверх биржевого стопа): BE-храповик + трейл.
ADOPT_BE_ARM_PCT=1.5                 # peak% для взвода безубытка (> 0)
ADOPT_BE_FLOOR_PCT=0                 # пол при взведённом храповике (0 = безубыток); [0, ARM)
ADOPT_TRAIL_ENABLED=false            # трейл няньки; выключен 23.08.2026 (медиана
                                     # отдачи от пика была 40% при пороге 30%)
ADOPT_TRAIL_ARM_PCT=2                # peak% для старта трейлинга (> 0)
ADOPT_TRAIL_GIVE_BACK_PCT=30         # доля пика, отдаваемая перед close; (0,100)
# Shadow time-cut (2026-07-02): measurement-only «не зеленеет — резать?». Поза
# старше MIN минут без MFE ≥ GREEN_PCT → would-be выход в shadow_exits. Живые
# выходы НЕ трогает; решение о включении — по месяцу данных.
ADOPT_TIMECUT_SHADOW_ENABLED=true    # это лог, торговлю не меняет
ADOPT_TIMECUT_MIN=75                 # минут без «зелени» до would-be cut (> 0)
ADOPT_TIMECUT_GREEN_PCT=0.3          # порог MFE, отменяющий cut (> 0)
# Пик-алерт: звонок оператору у пика (систематизация дискрец-выхода, не оракул).
# Условие: peak ≥ MFE_PCT и откат ≥ GIVEBACK_PCT от пика. GIVEBACK строго <
# ADOPT_TRAIL_GIVE_BACK_PCT — иначе трейл закроет раньше звонка. 1 пуш на позицию.
ADOPT_PEAK_ALERT_ENABLED=true
ADOPT_PEAK_ALERT_MFE_PCT=2.5         # p75 MFE adopt-шортов (анализ 2026-07-02)
ADOPT_PEAK_ALERT_GIVEBACK_PCT=15     # (0, ADOPT_TRAIL_GIVE_BACK_PCT)
# NTFY_TOPIC_ADOPT=                  # отдельный топик для adopt-пушей (пусто = NTFY_TOPIC)

# ── Daily loss limit — дневной стоп-лосс по fills (аудит 02.07: 8 худших дней = −$130) ──
# День достиг −LIMIT$ net (Σ closedPnl − fee, Europe/Warsaw) → urgent-пуш (1/день)
# + бот не открывает НОВЫЕ авто-входы до полуночи + тильт-алерт на усыновления.
# Няньку/выходы НЕ трогает. Это rail, не замок (кошелёк не заблокировать).
DAILY_LOSS_LIMIT_ENABLED=true
DAILY_LOSS_LIMIT_USD=5               # ≈7% депо $75; > 0

# ── Risk-based position sizing (cross-strategy: Hunter / Hunter Long / ChillBoy) ──
# Размер позиции считается от расстояния до SL (size = эквити × RISK_PCT / стоп-дистанция),
# чтобы лосс по стопу стоил фиксированный % эквити независимо от монеты. Carry не затрагивает (нет SL).
RISK_BASED_SIZING=false              # master flag risk-based сайзинга
RISK_SIZING_SHADOW=true              # true → только лог [RiskSizing SHADOW], размер не меняется (сбор данных)
RISK_PCT_PER_TRADE=0.01              # доля эквити под риском на сделку (0.01 = 1%); диапазон (0, 0.1]
# Iter E.2: trailing TP (PAPER, зеркало HUNTER_TRAIL_*). ARM_PCT < HUNTER_LONG_TP_PCT обязательно.

# ── Risk management ──────────────────────────────
MAX_DRAWDOWN_PCT=10           # стоп открытий при -X% от стартового equity сессии
CB_MAX_LOSSES=3               # circuit breaker: макс убытков подряд в окне 1ч
CB_PAUSE_HOURS=2              # пауза после срабатывания circuit breaker

# ── Рубильники уведомлений (канал — ntfy) ────────
# Риск-события (FAILED/CIRCUIT/DRAWDOWN/внешнее закрытие) от флагов не зависят.
ALERTS_NOISY=false             # FOMO, аномалии APY, PnL-качель, баны
ALERTS_TRADE=false             # OPEN/CLOSE/SL/TP/rotate

# ── ntfy — пуш на телефон при Candy Girl сигнале ──────────────────────────
# Если NTFY_URL пустой — ntfy-алерт тихо пропускается.
# Топик должен существовать и быть доступен твоему токену (write).
NTFY_URL=http://ntfy:80           # адрес ntfy (внутри Docker: http://ntfy:80; снаружи: https://ntfy.example.com)
NTFY_TOPIC=hl-signals             # топик для сигналов
NTFY_TOKEN=                       # Bearer-токен (NTFY_AUTH_DEFAULT_ACCESS=deny-all)
NTFY_PRIORITY=3                   # приоритет пуша, шкала ntfy 1..5 (НЕ Gotify 0..8): 3=звук+1 вибро, 4=high, 5=urgent (долгое вибро/обход DND)

# ── Hot Movers «enterable» алерт ─────────────────────────────────────
# Пуш, когда мувер с направленным Setup (trend/fade, OI-подтверждён) перешёл
# в чейз-зону 🎯 — улетел → откатился к базе, вход созрел (не чейз свечи).
NTFY_TOPIC_MOVERS=                # отдельный топик (пусто = NTFY_TOPIC)

# ── Watchlist-будильник «моя монета задвигалась» ─────────────────────
# Узкий пуш ТОЛЬКО по своим монетам (BTC/HYPE/SOL): монета внезапно двинулась
# И OI подтверждает (набирают позицию). Не сигнал — «иди посмотри». Топик
# переиспользует NTFY_TOPIC_MOVERS. Тихий час берётся из core (00–08).
WATCHLIST_ALERT_ENABLED=true
ALERT_WATCHLIST=BTC,HYPE,SOL      # монеты-будильники (через запятую); * = вся вселенная (тест/спам)
WATCHLIST_ALERT_INTERVAL_SEC=60   # период проверки
WATCHLIST_ALERT_WINDOW_MIN=5      # окно хода/OI
WATCHLIST_ALERT_MOVE_PCT=2.5      # порог хода цены за окно
WATCHLIST_ALERT_OI_PCT=3          # порог ΔOI за то же окно (подтверждение)
WATCHLIST_ALERT_COOLDOWN_MIN=45   # повторный пуш по той же монете
# OI-сёрдж: отдельный пуш «OI выше обычного» (резкий набор/сброс позиций),
# независим от ценового будильника. Порог 3% = «синяя» подсветка OI на дашборде.
WATCHLIST_OI_SURGE_ENABLED=true
WATCHLIST_OI_SURGE_PCT=3           # порог |ΔOI| для сёрджа
WATCHLIST_OI_SURGE_WINDOW_MIN=3    # окно сёрджа (3м≈6 снапшотов; 1м=2 точки→глитчи)
WATCHLIST_OI_SURGE_COOLDOWN_MIN=30 # повторный OI-пуш по той же монете

# ── «Гении Уолл-стрит»: открыли/закрыли позу ─────────────────────────
# Наблюдение за тремя замороженными адресами (docs/winners-preregistration.json).
# Событие = смена состояния позиции, не филл. Холодный пуш (priority 2): телефон
# не звенит, письмо не уходит. Вердикт теста 10.11 это не считает.
WINNERS_WATCH_ENABLED=true
WINNERS_WATCH_INTERVAL_SEC=60     # период опроса; вес ≈18 ед/мин при LOW-бюджете 700
WINNERS_WATCH_MIN_USD=500         # позиции мельче — пыль после закрытия, не решение

# ── Binance (read-only, для Tax Collector / PIT-38) ──
# Если оба пустые — модуль taxCollector тихо отключается, бот работает как раньше.
# Ключи нужны только с правом READ. НЕ давай право Trading/Withdraw.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Kraken (read-only, для Tax Collector / PIT-38) ──
# 🚨 Ключу нужно РОВНО одно право: "Query ledger entries".
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Tax Manager (push outbox в централизованный ledger) ──
# Если TAX_HMAC_SECRET пустой — pusher тихо отключается, бот работает как раньше.
# TAX_HMAC_SECRET — это sha256-hex от plaintext (см. INTEGRATION.md шаг 8).
TAX_MANAGER_URL=http://tax-api:3020
TAX_PROJECT=hl-paper-scanner
TAX_HMAC_SECRET=

# ── WS price feed ────────────────────────────────
# allMids WebSocket-фид живых цен. Гибрид: цены из WS, funding/OI из HTTP.
#
# Stage 1 (тень): поднимает WS, держит кэш цен, сверяет с 15-сек поллингом в
# логах. Торговую логику НЕ трогает. Поллинг = floor (на разрыве WS не слепнем).
HL_WS_FEED_ENABLED=false       # true чтобы поднять фид
# HL_WS_URL=wss://api.hyperliquid.xyz/ws
#
# Stage 2 (выходы на WS-тиках): выходы активной hunter/hunter_long позиции
# (trailing TP / SL / time-stop) считаются на живых WS-ценах, не раз в 15с.
# Требует HL_WS_FEED_ENABLED=true. Включать ТОЛЬКО после суток наблюдения тени.
HL_WS_EXIT_INTERVAL_MS=2000    # как часто пересчитывать выход (default 2с)
#
# Stage 3 (входы на WS-тиках): ⚠️ ПОВЕДЕНИЕ-МЕНЯЮЩАЯ. Открывает hunter/hunter_long
# быстрее 15-сек скана — меняет ЧАСТОТУ входов, не только точность. Требует
# HL_WS_FEED_ENABLED=true. Включать осознанно, после Stage 1/2 на проде.

# ── Account-state coalescing ─────────────────────
# balance/positions зовутся 6–12×/тик (integrity, orphan, hunter-reconcile,
# adopt, dashboard). Coalescer (src/core/accountState.js) даёт всем читателям
# ОДИН сетевой срез в окне TTL вместо десятка clearinghouseState-запросов.
# Hot-путь реконсайла (детект филлов после ордера) кэш НЕ трогает. После своей
# сделки бот сбрасывает кэш, поэтому equity/позиции обновляются сразу.
HL_BALANCE_TTL_MS=2500         # окно дедупа баланса (default 2.5с)
HL_POSITIONS_TTL_MS=2500       # окно дедупа позиций (default 2.5с)

# ── Логирование ──────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
