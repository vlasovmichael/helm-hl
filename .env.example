# ── Режим торговли ──────────────────────────────
TRADING_MODE=PAPER            # PAPER или PRODUCTION

# ── Кошелёк ─────────────────────────────────────
PUBLIC_WALLET_ADDRESS=0xYourWalletAddress
HL_AGENT_PRIVATE_KEY=         # ключ Agent Wallet (рекомендуется для PRODUCTION)
HL_PRIVATE_KEY=               # основной ключ (fallback, НЕ рекомендуется)

# ── RPC (Base mainnet) ───────────────────────────
RPC_URL=https://mainnet.base.org

# ── Режим агрессивности ──────────────────────────
# true = для депозитов $50-200 (ниже пороги, меньше round-trip)
# false = консервативный (для крупных депозитов)
# AGG_* переменные задают дефолты агрессивного режима.
# Отдельные переменные (MIN_APY_THRESHOLD и т.д.) переопределяют пресет если заданы явно.
AGGRESSIVE_MODE=false
AGG_MIN_APY=15                # aggressive default: MIN_APY_THRESHOLD
AGG_ENTRY_APY=25              # aggressive default: ENTRY_APY_THRESHOLD
AGG_ROUND_TRIP=0.0006         # aggressive default: ROUND_TRIP (0.06%)

# ── Торговые параметры ───────────────────────────
FAKE_BALANCE=                 # виртуальный баланс для PAPER (пустой = реальный withdrawable)
COIN_BLACKLIST=STBL           # неторгуемые тикеры через запятую (HLP-индексы и т.п.)
#MIN_APY_THRESHOLD=           # (override) выходим ниже этого APY
#ENTRY_APY_THRESHOLD=         # (override) заходим только выше этого APY
EXIT_BUFFER=5                 # реальный порог выхода = MIN_APY - EXIT_BUFFER
LEVERAGE=1                    # кредитное плечо (1 = без плеча)
MIN_HOLD_TIME_MINUTES=60      # нижний пол для динамического min-hold (фактический = max(60, hoursToBreakeven(entry_apy)*60), кап 24ч)
BREATHING_MINUTES=30          # декоративный пол для ротации (фактически перекрывается fee-recovery guard)

# ── Strategy constants ───────────────────────────
# Shared by carry and fade strategies. Tune carefully — these are the core risk knobs.
ROUND_TRIP=0.001              # round-trip cost (entry+exit). 0.1% = conservative, 0.06% = tight for liquid top-50
MAX_PAYBACK_HOURS=24          # rotation allowed only if delta APY pays back round-trip within this horizon
MAX_BREAKEVEN_HOURS=24        # entry fee-gate: won't enter if breakeven > this many hours
NEGATIVE_FUNDING_TICKS=2      # close after N consecutive ticks of negative funding (N×15s)
DELIST_CONFIRM_TICKS=3        # close after N consecutive ticks of coin missing from API (N×15s)
DELIST_COOLDOWN_MINUTES=30    # don't re-enter recently delisted coin for N minutes
MIN_ENTRY_APY_FLOOR=10        # hard floor: never enter below this APY regardless of other gates
PREDICTED_DROP_THRESHOLD=30   # carry skips coins where predicted funding drops >N% (fade targets them)
FUNDING_GATE_MINUTES=10       # block soft exits within N minutes of hourly funding payout

# ── Liquidity whitelist (Scout) ──────────────────
# Scout берёт только монеты из top-N по dayNtlVlm с минимальным объёмом.
# Кеш whitelist-а — раз в N часов, чтобы сам список не дёргался.
LIQUID_TOP_N=50               # размер whitelist (top-N по 24h volume)
LIQUID_MIN_VOLUME=10000000    # $10M/24h — hard floor до top-N фильтра
LIQUID_CACHE_HOURS=6          # TTL кеша whitelist-а

# ── Setup Scanner (manual-helper, не торговая логика) ──
# Scout раз в N минут пишет snapshot (funding/OI/premium/vol) по liquidSet
# в setup_snapshots → дашборд показывает конвергенцию сигналов. Retention 90 дней.
SETUP_SNAPSHOT_INTERVAL_MIN=60

# ── Carry trailing TP + spike protection ─────────
# Тюнинг 2026-05-11 на основе 36ч PROD: дед = по факту mean-reversion,
# fundingPnl=шум, P&L=price moves. Главная боль — глубокий stop по spike.
CARRY_ENABLED=true                   # Master flag. false = дед полностью выключен, только Hunter/ChillBoy.
CARRY_TRAIL_ENABLED=true
CARRY_TRAIL_ARM_PCT=3              # path A: arm trailing когда unrealized ≥ X% движения цены
CARRY_TRAIL_ARM_PCT_EQUITY=1.2     # path B: arm когда unrealized ≥ X% от equity (главный путь на малом депо)
CARRY_TRAIL_GIVE_BACK_PCT=25       # закрытие при откате ≥ Y% от пика (общий для A и B)
CARRY_SPIKE_PROTECTION_PCT=4       # forced market close если adverse move ≥ X% (был 6, снижен после VVV ×2)
CARRY_LOSS_COOLDOWN_MIN=720        # бан монеты на N мин после price_spike_protection (12ч). 0 = выключить
# ── Дед v2: breakeven храповик + «цена > фандинг» (2026-06-03) ──
# Дед — funding-машина, отдавал реальный ценовой подарок ($1+) обратно в 0, ждя
# negative_funding/apy_below. На депо $50-100 funding=шум, деньги делает цена.
CARRY_BE_RATCHET_ENABLED=true      # храповик: после плюса ≥ arm price-PnL не уходит ниже breakeven
CARRY_BE_ARM_PCT_EQUITY=0.5        # arm по %-equity порогу (ловит подарки меньше trail-arm 1.2%)
CARRY_BE_ARM_USD=0.40              # ИЛИ arm по абсолютному $-порогу (защита мелкого депо)
CARRY_BE_FLOOR_PCT_EQUITY=0        # пол по цене как % equity. 0 = чистый breakeven
CARRY_PRICE_OVER_FUNDING=true      # пока trail/ratchet взведён — funding-выходы (apy_below/decay/stale) не выдёргивают деда
# ── Carry "smart guards" (FARTCOIN 2026-05-13: висел 16h на флэте без profit) ──
# Любой из трёх guard'ов = 0 → выключить.
CARRY_STALE_TIMEOUT_MIN=360        # close если за N мин ни разу не достигли STALE_MIN_PNL_EQUITY
CARRY_STALE_MIN_PNL_EQUITY=0.5     # минимальный peak equity PnL% для "позиция работает" (0.5% от депо)
CARRY_APY_DECAY_EXIT_RATIO=0.5     # close если slowApy/entryApy < ratio (игнорим hold lock). FARTCOIN: 15/37 = 0.4 → выход
CARRY_MAX_HOLD_MIN=480             # жёсткий потолок dynamic hold lock (8h). Защита от 23.5h хвостов

# ── Carry entry trend gate (Дед v3 — вход-аналог v2 «цена решает») ──
# v2 защитил выход; вход остался funding-only → fade-short в живой тренд → 8ч underwater.
# Не входим пока за LOOKBACK импульс ещё против нас > ADVERSE_PCT (ждём, пока выдохнется).
# Окно короткое: пампанувшая 2ч назад и вставшая на плато монета пройдёт (валидный fade).
# Default OFF — paper-first, включать после ~2 нед shadow-данных.
CARRY_ENTRY_TREND_ENABLED=false
CARRY_ENTRY_TREND_LOOKBACK_MIN=15  # окно recent-импульса
CARRY_ENTRY_TREND_ADVERSE_PCT=0.6  # block если adverse move > X% за окно

# ── Carry Long (Iter 1.0–1.4 готов, OFF по проектному pivot к price-action) ──
CARRY_LONG_ENABLED=false           # включить long-carry (negative funding hunt). По pivot 2026-05-08 НЕ включаем.

# ── Market Regime — защита carry-входов от тренда ──
# Iter A (per-coin velocity): не шортим монету которая выросла >X% за N мин (и зеркально для long).
# Iter B (BTC regime): глобальный гейт — если BTC pumpнул >pct → блок short-входов; dump → блок long.
# Оба под флагами, default OFF — на проде оба true.
MARKET_REGIME_VELOCITY_ENABLED=true
MARKET_REGIME_COIN_PUMP_PCT=3      # bucket 1: спайк (default 30мин/3%)
MARKET_REGIME_LOOKBACK_MIN=30
MARKET_REGIME_COIN_PUMP_PCT2=5     # bucket 2: pump→plateau (XMR/TON-паттерн, 2ч/5%). 0 в LOOKBACK2 = выкл
MARKET_REGIME_LOOKBACK2_MIN=120
MARKET_REGIME_BTC_ENABLED=true
MARKET_REGIME_BTC_PUMP_PCT=2       # BTC pump/dump threshold (%)
MARKET_REGIME_BTC_LOOKBACK_MIN=60

# ── Стратегия #2: Predicted Funding Fade ─────────
# Шортим монеты с экстремальным спайком фандинга, который прогнозируется к падению.
# Собираем 1-2 часа высокого фандинга, выходим по time-stop.
FADE_ENABLED=false            # soft kill 2026-05-12: за месяц paper 0 срабатываний (комбо apy≥200% + drop≥40% + breakeven≤2h почти невозможна на top-50 ликвидных). Код в репо, можно вернуть переключателем.
FADE_MAX_HOLD_MINUTES=120     # жёсткий time-stop (мин)
FADE_MIN_CURRENT_APY=200      # минимальный текущий APY для входа (%)
FADE_MIN_DROP_PCT=40           # минимальный прогнозируемый drop (%)

# ── Sniper-Hunter (Volatility Spike Mean-Reversion, Strategy #3) ──
# Стратегия SHORT-after-pump: спайк ≥X%/2мин → шорт + SL +2% / TP −3% триггерами.
# Двойной gate для безопасности:
#   HUNTER_ENABLED=true      → бот ловит сигналы (paper или prod зависит от MODE)
#   HUNTER_PROD_ENABLED=true → в production реально отправляются ордера на биржу
# В paper-режиме HUNTER_PROD_ENABLED игнорируется. В prod-режиме ОБА должны быть true.
HUNTER_ENABLED=true
HUNTER_PROD_ENABLED=true
HUNTER_SPIKE_PCT=3.0           # порог спайка за 2мин (%). Был 5.0 — 0 сигналов за 36ч, снижен до 3.0
HUNTER_MIN_VOLUME=1000000      # минимальный 24h volume для попадания в whitelist ($)
HUNTER_TREND_LOOKBACK_MIN=15   # окно anti-trend filter (мин)
HUNTER_TREND_MAX_RISE_PCT=8    # макс рост за это окно — выше = тренд, не reversion
HUNTER_POST_SL_COOLDOWN_MIN=30 # после SL не возвращаемся к монете N минут
HUNTER_TIME_STOP_MIN=60        # позиция закрывается по market если за N мин ни SL ни TP
# Leverage только для Hunter (carry/fade всегда 1x). Умножает РАЗМЕР позиции.
# При SL=2%: 1x → −1% от баланса, 3x → −3%, 5x → −5%. Range [1, 10].
# Начинать с 1, повышать после первых 10-20 PROD-сделок и анализа slippage.
HUNTER_LEVERAGE=1
# Доля баланса на позицию Hunter. SHORT и Long тюнятся раздельно.
# Нотиональный множитель к балансу = util × HUNTER_LEVERAGE. Range (0, 0.95].
# SHORT: данные 2026-05-15 (12 PROD-сделок, +$6.76, avg +$0.56, 75% WR) →
#   стадийный подъём 0.5 → 0.7. Следующий шаг 0.7 → 0.85 после ~10-15 сделок.
# Long: матожидание пока отрицательное (7 trades, −$1.35) → держим 0.5.
HUNTER_BALANCE_UTILIZATION=0.70
HUNTER_LONG_BALANCE_UTILIZATION=0.5

# Iter D: trailing TP для Hunter SHORT (PROD-ready, код Iter D2 готов).
# Поток: при ARM (peak ≥ ARM_PCT) бот отменяет биржевой TP-trigger и переходит
# на bot-driven trailing close (close если peak отдан на GIVE_BACK_PCT). SL на
# бирже остаётся как floor. ARM_PCT строго < HUNTER_TP_PCT (=3).
# SHADOW_LOG=true пишет "would-have-trailed" события даже при ENABLED=false.
# 2026-05-13: default flipped to true — shadow collected с 2026-05-11, код стабилен.
HUNTER_TRAIL_ENABLED=true
HUNTER_TRAIL_SHADOW_LOG=true
HUNTER_TRAIL_ARM_PCT=2                # arm trail когда unrealized% пересёк +X%
HUNTER_TRAIL_GIVE_BACK_PCT=30         # close если откатили ≥Y% от пика

# ── Hunter Long (Iter E.1) — Long-after-dump, заняла слот после Fade soft-kill ──
# Зеркало Hunter SHORT: триггер на резкий ДАМП ≥X%/2мин → лонг с SL ниже / TP выше.
# Default OFF — включить только когда готовы наблюдать в PAPER.
# PROD путь будет в Iter E.3 (отдельный gate HUNTER_LONG_PROD_ENABLED).
HUNTER_LONG_ENABLED=true
HUNTER_LONG_PROD_ENABLED=true         # Iter E.3 activated 2026-05-13: shadow за 36ч дал 9 сигналов (SAGA×6, TON, DYM, APE), код production.js готов с Iter E.1.
HUNTER_LONG_DUMP_PCT=3.0              # порог дампа за 2мин (%, по модулю)
HUNTER_LONG_SL_PCT=2.0                # SL: entry × (1 − SL%/100) — ниже entry
HUNTER_LONG_TP_PCT=3.0                # TP: entry × (1 + TP%/100) — выше entry
HUNTER_LONG_TREND_LOOKBACK_MIN=15     # окно anti-trend filter
HUNTER_LONG_TREND_MAX_DROP_PCT=6      # макс падение за это окно — глубже = устойчивый downtrend (агрессивнее, чем Hunter SHORT с 8%)
HUNTER_LONG_POST_SL_COOLDOWN_MIN=180  # после SL не возвращаемся N мин (2026-05-20: 60→180, SAGA/VVV repeat-SL pattern)
HUNTER_LONG_TIME_STOP_MIN=60          # позиция закрывается по market если за N мин ни SL ни TP
# 2026-05-20: toxic-coin filters (после Hunter LONG −$1.93/12tr анализа, главный убыток TST −$1.80 на delist)
HUNTER_LONG_MIN_OI_USD=500000         # min open interest на монету для входа; null/missing → пропуск проверки (graceful)
HUNTER_LONG_MIN_VOL_24H_USD=5000000   # min 24h notional volume; защита от low-liquidity halt/delist
HUNTER_LONG_SL_STREAK_BAN=2           # после N подряд SL'ов в окне WINDOW_HOURS → длинный бан BAN_HOURS
HUNTER_LONG_SL_STREAK_WINDOW_HOURS=6  # окно, в котором SL'ы считаются "подряд"
HUNTER_LONG_SL_STREAK_BAN_HOURS=24    # длительность бана после streak'а
# Cross-strategy cooldown: после ЛЮБОГО close (SHORT или LONG) монета на N мин запрещена
# для второй Hunter-стратегии. Защита от ловли ножа (SAGA 2026-05-13: SHORT TP → LONG ×2 SL).
HUNTER_CROSS_COOLDOWN_MIN=60

# Vol-based position sizing для carry: размер × clamp(1 − volIdx × penalty, minMult, 1).
# penalty=50, minMult=0.4: VolIdx=0.003→×1.00, 0.008→×0.60, 0.015→×0.40.
# Защита от паттерна "5 winners × $0.50 vs 1 loser × $2.17" (VVV 2026-05-13).
CARRY_VOL_SIZE_PENALTY=50
CARRY_VOL_SIZE_MIN_MULT=0.4

# ─── Strategy #4: trend_follow (codename Chill Boy) ─────────────────────
# Vol-squeeze breakout trend-follower. План: memory/trend_follow_plan.md.
# Iter F.1: PAPER. Iter F.3: PROD path реализован, гейт ниже.
CHILL_BOY_ENABLED=false              # Master flag. Включает стратегию (paper или prod — зависит от PROD_ENABLED ниже).
CHILL_BOY_ALERT_ENABLED=false        # TG-алерты о пробоях. false = тихо (сигналы идут в ленту дашборда, но не в TG).
CHILL_BOY_PROD_ENABLED=false         # PROD-gate. Реальные ордера. Включать после 2+ недель PAPER в плюсе.
CHILL_BOY_ATR_SHORT=20               # короткая ATR window (свечей)
CHILL_BOY_ATR_LONG=50                # длинная ATR window (для squeeze ratio)
CHILL_BOY_SQUEEZE_RATIO=0.7          # squeeze если ATR(short)/ATR(long) < этого
CHILL_BOY_BREAKOUT_MULT=0.5          # breakout = range_high(short) ± ATR × этого
CHILL_BOY_SL_ATR_MULT=1.5            # SL = entry ± SL_MULT × ATR
CHILL_BOY_TP_ATR_MULT=3.0            # TP = entry ± TP_MULT × ATR (R:R 2:1)
CHILL_BOY_TIME_STOP_HOURS=6          # time-stop если breakout не отработал
CHILL_BOY_BALANCE_UTILIZATION=0.5    # 50% баланса (PAPER). На F.3 prod-activation начнём с 0.25.
CHILL_BOY_POST_SL_COOLDOWN_MIN=120   # после SL не возвращаемся 2ч (false breakouts кластеризуются)
CHILL_BOY_PAPER_VIRTUAL_BALANCE=0    # >0 → стартовый seed виртуальной песочницы (USD). Equity хранится в data/chillboy_virtual.json и обновляется после каждой закрытой trend_follow PAPER сделки (compound). 0 = старое поведение (real paper balance, без compound).
CHILL_BOY_PAPER_VIRTUAL_UTILIZATION=0.9  # доля equity на сделку в virtual режиме (default 0.9 ~ как у carry). Реальный paper продолжает использовать CHILL_BOY_BALANCE_UTILIZATION.

# ─── Candy Girl — SIGNAL-ONLY радар (1h EMA-тренд + 5m pullback-reclaim) ──
# ⚠️ НЕ торговая стратегия: радар сетапов для РУЧНОЙ торговли (бот НИКОГДА не
# входит). План: memory/candy_girl_idea.md. Подсвечивает «1h-тренд по EMA20/200
# + откат к 5m EMA20 + reclaim» и шлёт TG-алерт, чтобы оператор собрал ручные сделки.
CANDY_GIRL_ENABLED=false               # Master flag. Включает скан радара в тике (default OFF).
CANDY_GIRL_ALERT_ENABLED=true          # слать TG-алерт на найденный сетап (лента в дашборде идёт всегда)
CANDY_GIRL_FAST_1H=20                  # быстрая EMA на 1h (тренд)
CANDY_GIRL_SLOW_1H=200                 # медленная EMA на 1h (тренд + наклон)
CANDY_GIRL_SLOPE_LOOKBACK=10           # за сколько 1h-свечей мерить наклон EMA200
CANDY_GIRL_EMA_5M=20                   # EMA на 5m (точка входа: откат к ней + reclaim)
CANDY_GIRL_PULLBACK_LOOKBACK=6         # в скольких последних 5m-свечах искать откат до reclaim
CANDY_GIRL_RR=2                        # R:R для TP (TP = entry ± RR × risk; SL = свинг отката)
CANDY_GIRL_ALERT_COOLDOWN_MIN=45       # дедуп per-coin: не чаще раза в N минут
CANDY_GIRL_MAX_SIGNALS_PER_TICK=3      # анти-фонтан: максимум записей за один скан
# ── Candy Girl paper-слот (Iter 2): shadow-стратегия в PROD-боте ──
# Торгует лучший ранжированный сигнал виртуально (compound sandbox), собирая P&L
# с комиссиями ~2 недели перед PROD-гейтом. Свой single-slot, независим от ChillBoy.
CANDY_GIRL_PROD_ENABLED=false          # PROD-путь НЕ построен — флаг лишь глушит shadow-слот когда станет true. Не включать.
CANDY_GIRL_PAPER_VIRTUAL_BALANCE=115   # >0 → seed виртуальной песочницы (USD), data/candy_virtual.json (compound). 0 = real paper balance.
CANDY_GIRL_PAPER_VIRTUAL_UTILIZATION=0.9  # доля equity на сделку в virtual режиме
CANDY_GIRL_BALANCE_UTILIZATION=0.5     # доля реального paper-баланса (когда VIRTUAL_BALANCE=0)

# ── Strategy #5: Fader — contrarian fade scalper (PAPER-only) ──
# План: plans/fader-strategy-plan.md. Sandbox для проверки ручного style оператора
# (fade на choppy монетах, без SL, маленький адаптивный TP). 1 paper slot на пару
# с ChillBoy. Compound sandbox через FADER_VIRTUAL_BALANCE.
FADER_ENABLED=true                       # master switch стратегии
FADER_VIRTUAL_BALANCE=115                # стартовый seed виртуального счёта (USD), data/fader_virtual.json
FADER_NOMINAL_USD=50                     # nominal на сделку ($50 как у оператора)
FADER_LEVERAGE=2                         # 2x leverage → notional = nominal × leverage = $100
FADER_SPIKE_WINDOW_MIN=5                 # окно для расчёта impulse + chopRatio
FADER_SPIKE_PCT_MIN=1.5                  # минимальный |move| за окно для fade-сигнала
FADER_CHOP_RATIO_MIN=2.0                 # range/|net| ≥ X → choppy, торгуем
FADER_CHOP_TREND_BREAK_MIN=1.5           # chopRatio ≤ X 3× подряд → trend-break exit
FADER_EDGE_BAND_PCT=0.25                 # цена в верхнем/нижнем X% диапазона для GREEN
FADER_TP_RECLAIM_FRAC=0.4                # TP-distance = impulsePct × этого (40% отката)
FADER_TP_FLOOR_USD=0.20                  # минимальный TP в $ (fee+slip-floor)
FADER_TP_CEILING_USD=2.00                # максимальный TP в $ (anti-over-fit)
FADER_ADVERSE_KILL_PCT=0.20              # close если unrealized ≤ -20% от nominal (-$10 на $50)
FADER_TIME_STOP_HOURS=24                 # close по market если TP не сработал за N часов
FADER_REENTRY_COOLDOWN_MIN=10            # не входим в ту же монету N мин после закрытия
FADER_LOSS_STREAK_LIMIT=3                # >= N убытков подряд → пауза
FADER_LOSS_STREAK_WINDOW_MIN=60          # окно для подсчёта убытков подряд
FADER_LOSS_STREAK_PAUSE_MIN=60           # длительность паузы после loss-streak
FADER_FEE_ROUNDTRIP_PCT=0.09             # 0.045% taker × 2 = 0.09% от notional на round-trip
FADER_SLIPPAGE_ROUNDTRIP_USD=0.10        # фикс slippage на round-trip (модельный)
# ── Risk-based position sizing (cross-strategy: Hunter / Hunter Long / ChillBoy) ──
# Размер позиции считается от расстояния до SL (size = эквити × RISK_PCT / стоп-дистанция),
# чтобы лосс по стопу стоил фиксированный % эквити независимо от монеты. Carry не затрагивает (нет SL).
RISK_BASED_SIZING=false              # master flag risk-based сайзинга
RISK_SIZING_SHADOW=true              # true → только лог [RiskSizing SHADOW], размер не меняется (сбор данных)
RISK_PCT_PER_TRADE=0.01              # доля эквити под риском на сделку (0.01 = 1%); диапазон (0, 0.1]
# Iter E.2: trailing TP (PAPER, зеркало HUNTER_TRAIL_*). ARM_PCT < HUNTER_LONG_TP_PCT обязательно.
# SHADOW_LOG=true даёт "would-have-trailed" события даже при ENABLED=false — для оценки эффекта.
HUNTER_LONG_TRAIL_ENABLED=false
HUNTER_LONG_TRAIL_SHADOW_LOG=true
HUNTER_LONG_TRAIL_ARM_PCT=2           # arm trail когда unrealized% пересёк +X% (LONG: цена выше entry на X%)
HUNTER_LONG_TRAIL_GIVE_BACK_PCT=30    # close если откатили ≥Y% от пика

# ── Risk management ──────────────────────────────
MAX_DRAWDOWN_PCT=10           # стоп открытий при -X% от стартового equity сессии
CB_MAX_LOSSES=3               # circuit breaker: макс убытков подряд в окне 1ч
CB_PAUSE_HOURS=2              # пауза после срабатывания circuit breaker

# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
SILENT_START_HOUR=22           # начало тихого режима (час по серверному времени)
SILENT_END_HOUR=9              # конец тихого режима

# ── Шумовые TG-уведомления (один рубильник, по умолчанию ВЫКЛ) ──
# Гасит информационный шум: FOMO, аномалия APY, PnL-качель ±3%,
# OPEN BLOCKED/SKIPPED, OI CAP BAN, SLIPPAGE BAN.
# Сделки, SL/TP, ошибки и аварийные события (FAILED/REJECTED/CIRCUIT BREAKER/
# DRAWDOWN/внешнее закрытие) НЕ зависят от флага — приходят всегда.
TG_NOTIFICATIONS=false         # =true чтобы вернуть весь шум

# ── ntfy — пуш на телефон при Candy Girl сигнале ──────────────────────────
# Если NTFY_URL пустой — ntfy-алерт тихо пропускается.
# Топик должен существовать и быть доступен твоему токену (write).
NTFY_URL=http://ntfy:80           # адрес ntfy (внутри Docker: http://ntfy:80; снаружи: https://ntfy.example.com)
NTFY_TOPIC=hl-signals             # топик для сигналов
NTFY_TOKEN=                       # Bearer-токен (NTFY_AUTH_DEFAULT_ACCESS=deny-all)

# ── Binance (read-only, для Tax Collector / PIT-38) ──
# Если оба пустые — модуль taxCollector тихо отключается, бот работает как раньше.
# Ключи нужны только с правом READ. НЕ давай право Trading/Withdraw.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Tax Manager (push outbox в централизованный ledger) ──
# Если TAX_HMAC_SECRET пустой — pusher тихо отключается, бот работает как раньше.
# TAX_HMAC_SECRET — это sha256-hex от plaintext (см. INTEGRATION.md шаг 8).
TAX_MANAGER_URL=http://tax-api:3020
TAX_PROJECT=hl-paper-scanner
TAX_HMAC_SECRET=

# ── WS price feed ────────────────────────────────
# allMids WebSocket-фид живых цен. Гибрид: цены из WS, funding/OI из HTTP.
#
# Stage 1 (тень): поднимает WS, держит кэш цен, сверяет с 15-сек поллингом в
# логах. Торговую логику НЕ трогает. Поллинг = floor (на разрыве WS не слепнем).
HL_WS_FEED_ENABLED=false       # true чтобы поднять фид
# HL_WS_URL=wss://api.hyperliquid.xyz/ws
#
# Stage 2 (выходы на WS-тиках): выходы активной hunter/hunter_long позиции
# (trailing TP / SL / time-stop) считаются на живых WS-ценах, не раз в 15с.
# Требует HL_WS_FEED_ENABLED=true. Включать ТОЛЬКО после суток наблюдения тени.
HL_WS_EXITS_ENABLED=false      # true чтобы выходы шли по WS-тикам
HL_WS_EXIT_INTERVAL_MS=2000    # как часто пересчитывать выход (default 2с)
#
# Stage 3 (входы на WS-тиках): ⚠️ ПОВЕДЕНИЕ-МЕНЯЮЩАЯ. Открывает hunter/hunter_long
# быстрее 15-сек скана — меняет ЧАСТОТУ входов, не только точность. Требует
# HL_WS_FEED_ENABLED=true. Включать осознанно, после Stage 1/2 на проде.
HL_WS_ENTRIES_ENABLED=false    # true чтобы входы шли по WS-тикам
HL_WS_ENTRY_INTERVAL_MS=2000   # как часто искать вход (default 2с)

# ── Логирование ──────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
