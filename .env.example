# ── Режим торговли ──────────────────────────────
TRADING_MODE=PAPER            # PAPER или PRODUCTION

# ── Кошелёк ─────────────────────────────────────
PUBLIC_WALLET_ADDRESS=0xYourWalletAddress
HL_AGENT_PRIVATE_KEY=         # ключ Agent Wallet (рекомендуется для PRODUCTION)
HL_PRIVATE_KEY=               # основной ключ (fallback, НЕ рекомендуется)

# ── RPC (Base mainnet) ───────────────────────────
RPC_URL=https://mainnet.base.org

# ── Торговые параметры ───────────────────────────
FAKE_BALANCE=                 # виртуальный баланс для PAPER (пустой = реальный withdrawable)
COIN_BLACKLIST=STBL           # неторгуемые тикеры через запятую (HLP-индексы и т.п.)
MIN_APY_THRESHOLD=20          # выходим ниже этого APY (с учётом EXIT_BUFFER)
ENTRY_APY_THRESHOLD=40        # заходим только выше этого APY
EXIT_BUFFER=5                 # реальный порог выхода = MIN_APY - EXIT_BUFFER = 25%
LEVERAGE=1                    # кредитное плечо (1 = без плеча)
MIN_HOLD_TIME_MINUTES=60      # нижний пол для динамического min-hold (фактический = max(60, hoursToBreakeven(entry_apy)*60), кап 24ч)
BREATHING_MINUTES=30          # декоративный пол для ротации (фактически перекрывается fee-recovery guard)

# ── Liquidity whitelist (Scout) ──────────────────
# Scout берёт только монеты из top-N по dayNtlVlm с минимальным объёмом.
# Кеш whitelist-а — раз в N часов, чтобы сам список не дёргался.
LIQUID_TOP_N=50               # размер whitelist (top-N по 24h volume)
LIQUID_MIN_VOLUME=10000000    # $10M/24h — hard floor до top-N фильтра
LIQUID_CACHE_HOURS=6          # TTL кеша whitelist-а

# ── Стратегия #2: Predicted Funding Fade ─────────
# Шортим монеты с экстремальным спайком фандинга, который прогнозируется к падению.
# Собираем 1-2 часа высокого фандинга, выходим по time-stop.
FADE_ENABLED=true             # включить/выключить fade-стратегию
FADE_MAX_HOLD_MINUTES=120     # жёсткий time-stop (мин)
FADE_MIN_CURRENT_APY=200      # минимальный текущий APY для входа (%)
FADE_MIN_DROP_PCT=40           # минимальный прогнозируемый drop (%)

# ── Risk management ──────────────────────────────
MAX_DRAWDOWN_PCT=10           # стоп открытий при -X% от стартового equity сессии
CB_MAX_LOSSES=3               # circuit breaker: макс убытков подряд в окне 1ч
CB_PAUSE_HOURS=2              # пауза после срабатывания circuit breaker

# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
SILENT_START_HOUR=22           # начало тихого режима (час по серверному времени)
SILENT_END_HOUR=9              # конец тихого режима

# ── Binance (read-only, для Tax Collector / PIT-38) ──
# Если оба пустые — модуль taxCollector тихо отключается, бот работает как раньше.
# Ключи нужны только с правом READ. НЕ давай право Trading/Withdraw.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Логирование ──────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
