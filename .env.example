# ── Режим торговли ──────────────────────────────
TRADING_MODE=PAPER            # PAPER или PRODUCTION

# ── Кошелёк ─────────────────────────────────────
PUBLIC_WALLET_ADDRESS=0xYourWalletAddress
HL_AGENT_PRIVATE_KEY=         # ключ Agent Wallet (рекомендуется для PRODUCTION)
HL_PRIVATE_KEY=               # основной ключ (fallback, НЕ рекомендуется)

# ── RPC (Base mainnet) ───────────────────────────
RPC_URL=https://mainnet.base.org

# ── Торговые параметры ───────────────────────────
FAKE_BALANCE=                 # виртуальный баланс для PAPER (пустой = реальный withdrawable)
COIN_BLACKLIST=STBL           # неторгуемые тикеры через запятую (HLP-индексы и т.п.)
MIN_APY_THRESHOLD=30          # выходим ниже этого APY (с учётом EXIT_BUFFER)
ENTRY_APY_THRESHOLD=60        # заходим только выше этого APY
EXIT_BUFFER=5                 # реальный порог выхода = MIN_APY - EXIT_BUFFER = 25%
LEVERAGE=1                    # кредитное плечо (1 = без плеча)
MIN_HOLD_TIME_MINUTES=60      # минимум 60 мин в позиции до обычного выхода
BREATHING_MINUTES=30          # игнорировать ротации первые 30 мин

# ── Risk management ──────────────────────────────
MAX_DRAWDOWN_PCT=10           # стоп открытий при -X% от стартового equity сессии
CB_MAX_LOSSES=3               # circuit breaker: макс убытков подряд в окне 1ч
CB_PAUSE_HOURS=2              # пауза после срабатывания circuit breaker

# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
SILENT_START_HOUR=22           # начало тихого режима (час по серверному времени)
SILENT_END_HOUR=9              # конец тихого режима

# ── Логирование ──────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
