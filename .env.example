# ── Кошелёк ─────────────────────────────────────────────────────────────────
PUBLIC_WALLET_ADDRESS=0xYourWalletAddress
HL_AGENT_PRIVATE_KEY=                # ключ Agent Wallet (рекомендуется для PRODUCTION)
HL_PRIVATE_KEY=                      # основной ключ (fallback, НЕ рекомендуется)

# ── Торговые параметры ──────────────────────────────────────────────────────
FAKE_BALANCE=                        # виртуальный баланс для PAPER (пусто = реальный withdrawable)
COIN_BLACKLIST=STBL                  # неторгуемые тикеры через запятую (HLP-индексы и т.п.)
LEVERAGE=1                           # кредитное плечо (1 = без плеча)
ROUND_TRIP=0.001                     # round-trip издержки входа+выхода (0.001 = 0.1%)
#MIN_APY_THRESHOLD=30                # (override) carry: выходим ниже этого APY
#ENTRY_APY_THRESHOLD=60               # (override) carry: заходим только выше этого APY

# ── Вселенная скана (Scout) ─────────────────────────────────────────────────
MIN_VOLUME_USD=1000000               # порог 24h-оборота для попадания в скан, $
LIQUID_TOP_N=50                      # размер whitelist: top-N по 24h-объёму
LIQUID_MIN_VOLUME=10000000           # hard floor по объёму до top-N фильтра, $
LIQUID_CACHE_HOURS=6                 # TTL кеша whitelist-а, чтобы список не дёргался
SETUP_SNAPSHOT_INTERVAL_MIN=60       # период снапшота funding/OI/premium в setup_snapshots

# ── Витрина Hot Movers ──────────────────────────────────────────────────────
# Фокус внимания, не гейт входа. Монета с открытой позой видна всегда.
HOT_MOVERS_COINS=BTC,SOL,HYPE        # свои монеты через запятую; пусто = вся вселенная

# ── Гейты режима рынка ──────────────────────────────────────────────────────
MARKET_REGIME_VELOCITY_ENABLED=true  # не шортить монету, которая только что выросла (и зеркально)
MARKET_REGIME_BTC_ENABLED=true       # BTC pump → блок шортов, dump → блок лонгов

# ── Тренд по EMA (витрина, не торговая логика) ──────────────────────────────
TREND_LOOKBACK_MIN=15                # окно тренда витрины, мин
TREND_EMA_FAST_1H=20                 # быстрая EMA на 1h
TREND_EMA_SLOW_1H=200                # медленная EMA на 1h (тренд + наклон)
TREND_SLOPE_LOOKBACK=10              # за сколько 1h-свечей мерить наклон EMA200

# ── Риск на сделку ──────────────────────────────────────────────────────────
# Нотионал = депо × RISK_PCT / дистанция стопа. Вход ручной, бот только считает.
ADOPT_RISK_PCT=5                     # % депо под риском в одной сделке; (0, 100)

# ── Цель (TP) на бирже при подхвате ─────────────────────────────────────────
# Reduce-only лимитка висит в книге и исполняется мейкером, без участия бота.
ADOPT_TP_ENABLED=true
ADOPT_TP_RR=1                        # целевой R:R (1 → breakeven-winrate 50%); (0, 10]
ADOPT_TP_MAX_PCT=15                  # потолок дистанции цели, % от входа; (0, 50)
ADOPT_TP_GRID=                       # сетка целей «доля@R» через запятую; пусто = одна цель

# ── Выход лимиткой (post-only) вместо маркета ───────────────────────────────
# Сначала reduce-only Alo на свою сторону книги, потом добивание маркетом.
CLOSE_LIMIT_ENABLED=true             # false → сразу маркет
CLOSE_LIMIT_WAIT_MS=20000            # сколько ждём налива мейкером; [1000, 300000]
CLOSE_LIMIT_POLL_MS=2000             # шаг опроса остатка позиции; [250, WAIT_MS]

# ── Нянька: подхват ручных позиций ──────────────────────────────────────────
ADOPT_ENABLED=false                  # master flag: ставит ЖИВЫЕ ордера на счёт
ADOPT_MAX_AGE_MIN=360                # не подхватывать orphan старше N мин
MANUAL_PAPER_ADOPT_ENABLED=true      # бумажный дубль ручных позиций для замеров

# ── Форвард по чужим прогнозам: сигнал TG-канала → бумажная поза ────────────
# Из поста берутся только монета, сторона и время; выход ведёт та же нянька.
# Размер крошечный и плечо 1 намеренно: замер про направление, а не про заработок.
# Позы видны на главной, журнал и итог — в Lab.
TG_SIGNAL_ENABLED=true
# Каналы: `хэндл|подпись` через запятую. Хэндл — имя публичной ленты t.me/s/<name>,
# подпись показывается в интерфейсе. Формат поста опознаётся сам (modules/tgSignals.js).
TG_SIGNAL_CHANNELS=somechannel|Some Signal Desk
TG_SIGNAL_SIZE_USD=10                # нотионал бумажной позы, $; > 0
TG_SIGNAL_LEVERAGE=1                 # плечо; [1, 50]
TG_SIGNAL_POLL_MIN=5                 # шаг опроса каналов, мин; >= 1
# 🚨 Лента отдаёт два десятка постов разом — без потолка возраста первый запуск
# открыл бы позы по прогнозам с уже известным исходом.
TG_SIGNAL_MAX_AGE_MIN=30             # (0, 240]
TG_SIGNAL_DEDUP_HOURS=6              # окно, в котором тот же прогноз не берётся дважды; > 0
TG_SIGNAL_MAX_SLOTS=10               # потолок одновременных сигнальных поз; >= 1

# Жёсткий стоп на бирже: dist = ATR(1h,14) × MULT, зажат в [MIN, MAX].
ADOPT_STOP_MODE=atr                  # atr | pct
ADOPT_ATR_MULT=1.5                   # множитель ATR
ADOPT_STOP_MIN_PCT=2                 # зажим снизу (не уже шума); (0, MAX)
ADOPT_STOP_MAX_PCT=8                 # зажим сверху (катастрофа-тормоз); < 20
ADOPT_STOP_PCT=5                     # фикс-% для режима pct и фолбэк без ATR; (0, 20)

# Безубыток-храповик. 🚨 Отдельного флага нет: выключается порогом ARM_PCT=999.
ADOPT_BE_ARM_PCT=1.5                 # peak% для взвода безубытка (> 0)
ADOPT_BE_FLOOR_PCT=0                 # пол при взведённом храповике (0 = безубыток); [0, ARM)

# Трейл няньки. Выключен 23.08.2026: медиана отдачи от пика 40% при пороге 30%.
ADOPT_TRAIL_ENABLED=false
ADOPT_TRAIL_ARM_PCT=2                # peak% для старта трейлинга (> 0)
ADOPT_TRAIL_GIVE_BACK_PCT=30         # доля пика, отдаваемая перед close; (0, 100)

# Умный трейл: на подходе к цели снимаем лимитку и ведём стоп за пиком.
ADOPT_TARGET_TRAIL_ENABLED=true      # true = лимитка снимается на ARM_R
ADOPT_TARGET_TRAIL_ARM_R=0.9         # ход в R, на котором снимаем лимитку (> 0)
ADOPT_TARGET_TRAIL_GIVE_BACK_R=0.25  # отступ трейла от пика, в R (> 0)
ADOPT_TRAIL_FLOOR_ORDER=true         # пол едет биржевым ордером, а не закрытием из бота
ADOPT_TRAIL_FLOOR_STEP_PCT=0.25      # минимальный шаг перестановки стопа, % от входа

# Shadow time-cut: только лог would-be выходов в shadow_exits, торговлю не меняет.
ADOPT_TIMECUT_SHADOW_ENABLED=true
ADOPT_TIMECUT_MIN=75                 # минут без «зелени» до would-be cut (> 0)
ADOPT_TIMECUT_GREEN_PCT=0.3          # порог MFE, отменяющий cut (> 0)

# Пик-алерт: звонок у пика. GIVEBACK строго < ADOPT_TRAIL_GIVE_BACK_PCT.
ADOPT_PEAK_ALERT_ENABLED=true
ADOPT_PEAK_ALERT_MFE_PCT=2.5         # порог пика для звонка, %
ADOPT_PEAK_ALERT_GIVEBACK_PCT=15     # откат от пика, запускающий звонок; (0, TRAIL_GIVE_BACK)

# ── Дневной стоп-лосс ───────────────────────────────────────────────────────
# День достиг −LIMIT$ net → urgent-пуш + бот не открывает новые входы до полуночи.
# Няньку и выходы НЕ трогает: это rail, не замок.
DAILY_LOSS_LIMIT_ENABLED=true
DAILY_LOSS_LIMIT_USD=5               # > 0

# ── Risk-based sizing ───────────────────────────────────────────────────────
RISK_BASED_SIZING=false              # master flag
RISK_SIZING_SHADOW=true              # true → только лог, размер не меняется
RISK_PCT_PER_TRADE=0.01              # доля эквити под риском на сделку; (0, 0.1]

# ── Риск-менеджмент ─────────────────────────────────────────────────────────
MAX_DRAWDOWN_PCT=10                  # стоп открытий при −X% от стартового equity сессии
CB_MAX_LOSSES=3                      # circuit breaker: макс убытков подряд в окне 1ч
CB_PAUSE_HOURS=2                     # пауза после срабатывания circuit breaker

# ── Уведомления (канал — ntfy) ──────────────────────────────────────────────
# Риск-события (FAILED/CIRCUIT/DRAWDOWN/внешнее закрытие) от флагов не зависят.
ALERTS_NOISY=false                   # FOMO, аномалии APY, PnL-качель, баны
ALERTS_TRADE=false                   # OPEN/CLOSE/SL/TP/rotate
NTFY_URL=http://ntfy:80              # внутри Docker: http://ntfy:80; снаружи — свой https-адрес ntfy
NTFY_TOPIC=hl-signals                # топик по умолчанию
DASHBOARD_PUBLIC_URL=                # внешний адрес дашборды: ссылка в письме-дайджесте
NTFY_TOKEN=                          # Bearer-токен (NTFY_AUTH_DEFAULT_ACCESS=deny-all)
NTFY_PRIORITY=3                      # шкала ntfy 1..5: 3=звук, 4=high, 5=urgent (обход DND)
#NTFY_QUIET_FROM=0                   # тихий час: с какого часа глушить некритичные пуши
#NTFY_QUIET_TO=8                     # тихий час: до какого часа
NTFY_TOPIC_MOVERS=                   # топик для муверов/будильника; пусто = NTFY_TOPIC
NTFY_TOPIC_ADOPT=                    # топик для adopt-пушей; пусто = NTFY_TOPIC

# ── Watchlist-будильник «моя монета задвигалась» ────────────────────────────
# Монета двинулась И OI подтверждает. Не сигнал — «иди посмотри».
WATCHLIST_ALERT_ENABLED=true
ALERT_WATCHLIST=BTC,HYPE,SOL         # монеты-будильники; * = вся вселенная (спам, только для теста)
WATCHLIST_ALERT_INTERVAL_SEC=60      # период проверки
WATCHLIST_ALERT_WINDOW_MIN=5         # окно хода/OI
WATCHLIST_ALERT_MOVE_PCT=2.5         # порог хода цены за окно, %
WATCHLIST_ALERT_OI_PCT=3             # порог ΔOI за то же окно, %
WATCHLIST_ALERT_COOLDOWN_MIN=45      # повторный пуш по той же монете
WATCHLIST_OI_SURGE_ENABLED=true      # отдельный пуш «OI выше обычного», без требования хода
WATCHLIST_OI_SURGE_PCT=3             # порог |ΔOI| для сёрджа, %
WATCHLIST_OI_SURGE_WINDOW_MIN=3      # окно сёрджа (1м = 2 точки → глитчи)
WATCHLIST_OI_SURGE_COOLDOWN_MIN=30   # повторный OI-пуш по той же монете

# ── «Гении Уолл-стрит»: открыли/закрыли позу ────────────────────────────────
# Три замороженных адреса (docs/winners-preregistration.json). Холодный пуш.
WINNERS_WATCH_ENABLED=true
WINNERS_WATCH_INTERVAL_SEC=60        # период опроса
WINNERS_WATCH_MIN_USD=500            # позиции мельче — пыль, не решение

# ── Tax Collector / PIT-38 ──────────────────────────────────────────────────
# Пустые ключи = модуль тихо отключается. Права только READ, без Trading/Withdraw.
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=                      # 🚨 ровно одно право: "Query ledger entries"
KRAKEN_API_SECRET=
TAX_MANAGER_URL=http://tax-api:3020
TAX_PROJECT=hl-paper-scanner
TAX_HMAC_SECRET=                     # sha256-hex от plaintext; пусто = pusher выключен

# ── Почта (Listmonk): дайджест 21:05 + мгновенные письма ────────────────────
# Пустой MAIL_TO или LISTMONK_URL = почта тихо отключается.
LISTMONK_URL=
LISTMONK_USER=
LISTMONK_PASS=
LISTMONK_FROM_EMAIL=
LISTMONK_TX_TEMPLATE_ID=
MAIL_TO=
MAIL_INSTANT=true                    # письмо на каждый горячий пуш (priority ≥ 3)

# ── Дашборд ─────────────────────────────────────────────────────────────────
DASHBOARD_USER=                      # basic-auth; пусто = без пароля
DASHBOARD_PASS=

# ── WS price feed ───────────────────────────────────────────────────────────
# allMids WebSocket: цены из WS, funding/OI из HTTP. Поллинг остаётся floor'ом.
HL_WS_FEED_ENABLED=false             # true чтобы поднять фид
HL_WS_EXIT_INTERVAL_MS=2000          # как часто пересчитывать выход на WS-тиках

# ── Дедуп сетевых чтений счёта ──────────────────────────────────────────────
# Один срез balance/positions на всех читателей в окне TTL вместо десятка запросов.
HL_BALANCE_TTL_MS=2500
HL_POSITIONS_TTL_MS=2500

# ── Дисциплина и форварды ───────────────────────────────────────────────────
SCREEN_TRADES_PER_DAY=5              # бюджет сделок в день (трение на входе)
LIQ_WICK_PCT=1.5                     # порог фитиля для форварда liq-wick, %

# ── Логирование ─────────────────────────────────────────────────────────────
LOG_LEVEL=info                       # debug | info | warn | error
