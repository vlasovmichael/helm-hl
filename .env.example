# ── Режим торговли ──────────────────────────────
TRADING_MODE=PAPER            # PAPER или PRODUCTION

# ── Кошелёк ─────────────────────────────────────
PUBLIC_WALLET_ADDRESS=0xYourWalletAddress
HL_AGENT_PRIVATE_KEY=         # ключ Agent Wallet (рекомендуется для PRODUCTION)
HL_PRIVATE_KEY=               # основной ключ (fallback, НЕ рекомендуется)

# ── RPC (Base mainnet) ───────────────────────────
RPC_URL=https://mainnet.base.org

# ── Режим агрессивности ──────────────────────────
# true = для депозитов $50-200 (ниже пороги, меньше round-trip)
# false = консервативный (для крупных депозитов)
# AGG_* переменные задают дефолты агрессивного режима.
# Отдельные переменные (MIN_APY_THRESHOLD и т.д.) переопределяют пресет если заданы явно.
AGGRESSIVE_MODE=false
AGG_MIN_APY=15                # aggressive default: MIN_APY_THRESHOLD
AGG_ENTRY_APY=25              # aggressive default: ENTRY_APY_THRESHOLD
AGG_ROUND_TRIP=0.0006         # aggressive default: ROUND_TRIP (0.06%)

# ── Торговые параметры ───────────────────────────
FAKE_BALANCE=                 # виртуальный баланс для PAPER (пустой = реальный withdrawable)
COIN_BLACKLIST=STBL           # неторгуемые тикеры через запятую (HLP-индексы и т.п.)
#MIN_APY_THRESHOLD=           # (override) выходим ниже этого APY
#ENTRY_APY_THRESHOLD=         # (override) заходим только выше этого APY
EXIT_BUFFER=5                 # реальный порог выхода = MIN_APY - EXIT_BUFFER
LEVERAGE=1                    # кредитное плечо (1 = без плеча)
MIN_HOLD_TIME_MINUTES=60      # нижний пол для динамического min-hold (фактический = max(60, hoursToBreakeven(entry_apy)*60), кап 24ч)
BREATHING_MINUTES=30          # декоративный пол для ротации (фактически перекрывается fee-recovery guard)

# ── Strategy constants ───────────────────────────
# Shared by carry and fade strategies. Tune carefully — these are the core risk knobs.
ROUND_TRIP=0.001              # round-trip cost (entry+exit). 0.1% = conservative, 0.06% = tight for liquid top-50
MAX_PAYBACK_HOURS=24          # rotation allowed only if delta APY pays back round-trip within this horizon
MAX_BREAKEVEN_HOURS=24        # entry fee-gate: won't enter if breakeven > this many hours
NEGATIVE_FUNDING_TICKS=2      # close after N consecutive ticks of negative funding (N×15s)
DELIST_CONFIRM_TICKS=3        # close after N consecutive ticks of coin missing from API (N×15s)
DELIST_COOLDOWN_MINUTES=30    # don't re-enter recently delisted coin for N minutes
MIN_ENTRY_APY_FLOOR=10        # hard floor: never enter below this APY regardless of other gates
PREDICTED_DROP_THRESHOLD=30   # carry skips coins where predicted funding drops >N% (fade targets them)
FUNDING_GATE_MINUTES=10       # block soft exits within N minutes of hourly funding payout

# ── Liquidity whitelist (Scout) ──────────────────
# Scout берёт только монеты из top-N по dayNtlVlm с минимальным объёмом.
# Кеш whitelist-а — раз в N часов, чтобы сам список не дёргался.
LIQUID_TOP_N=50               # размер whitelist (top-N по 24h volume)
LIQUID_MIN_VOLUME=10000000    # $10M/24h — hard floor до top-N фильтра
LIQUID_CACHE_HOURS=6          # TTL кеша whitelist-а

# ── Carry trailing TP + spike protection ─────────
# Тюнинг 2026-05-11 на основе 36ч PROD: дед = по факту mean-reversion,
# fundingPnl=шум, P&L=price moves. Главная боль — глубокий stop по spike.
CARRY_TRAIL_ENABLED=true
CARRY_TRAIL_ARM_PCT=3              # path A: arm trailing когда unrealized ≥ X% движения цены
CARRY_TRAIL_ARM_PCT_EQUITY=1.2     # path B: arm когда unrealized ≥ X% от equity (главный путь на малом депо)
CARRY_TRAIL_GIVE_BACK_PCT=25       # закрытие при откате ≥ Y% от пика (общий для A и B)
CARRY_SPIKE_PROTECTION_PCT=4       # forced market close если adverse move ≥ X% (был 6, снижен после VVV ×2)
CARRY_LOSS_COOLDOWN_MIN=720        # бан монеты на N мин после price_spike_protection (12ч). 0 = выключить

# ── Стратегия #2: Predicted Funding Fade ─────────
# Шортим монеты с экстремальным спайком фандинга, который прогнозируется к падению.
# Собираем 1-2 часа высокого фандинга, выходим по time-stop.
FADE_ENABLED=false            # soft kill 2026-05-12: за месяц paper 0 срабатываний (комбо apy≥200% + drop≥40% + breakeven≤2h почти невозможна на top-50 ликвидных). Код в репо, можно вернуть переключателем.
FADE_MAX_HOLD_MINUTES=120     # жёсткий time-stop (мин)
FADE_MIN_CURRENT_APY=200      # минимальный текущий APY для входа (%)
FADE_MIN_DROP_PCT=40           # минимальный прогнозируемый drop (%)

# ── Sniper-Hunter (Volatility Spike Mean-Reversion, Strategy #3) ──
# Стратегия SHORT-after-pump: спайк ≥X%/2мин → шорт + SL +2% / TP −3% триггерами.
# Двойной gate для безопасности:
#   HUNTER_ENABLED=true      → бот ловит сигналы (paper или prod зависит от MODE)
#   HUNTER_PROD_ENABLED=true → в production реально отправляются ордера на биржу
# В paper-режиме HUNTER_PROD_ENABLED игнорируется. В prod-режиме ОБА должны быть true.
HUNTER_ENABLED=true
HUNTER_PROD_ENABLED=true
HUNTER_SPIKE_PCT=3.0           # порог спайка за 2мин (%). Был 5.0 — 0 сигналов за 36ч, снижен до 3.0
HUNTER_MIN_VOLUME=1000000      # минимальный 24h volume для попадания в whitelist ($)
HUNTER_TREND_LOOKBACK_MIN=15   # окно anti-trend filter (мин)
HUNTER_TREND_MAX_RISE_PCT=8    # макс рост за это окно — выше = тренд, не reversion
HUNTER_POST_SL_COOLDOWN_MIN=30 # после SL не возвращаемся к монете N минут
HUNTER_TIME_STOP_MIN=60        # позиция закрывается по market если за N мин ни SL ни TP
# Leverage только для Hunter (carry/fade всегда 1x). Умножает РАЗМЕР позиции.
# При SL=2%: 1x → −1% от баланса, 3x → −3%, 5x → −5%. Range [1, 10].
# Начинать с 1, повышать после первых 10-20 PROD-сделок и анализа slippage.
HUNTER_LEVERAGE=1

# Iter D: trailing TP для Hunter SHORT (PROD-ready, код Iter D2 готов).
# Поток: при ARM (peak ≥ ARM_PCT) бот отменяет биржевой TP-trigger и переходит
# на bot-driven trailing close (close если peak отдан на GIVE_BACK_PCT). SL на
# бирже остаётся как floor. ARM_PCT строго < HUNTER_TP_PCT (=3).
# SHADOW_LOG=true пишет "would-have-trailed" события даже при ENABLED=false.
HUNTER_TRAIL_ENABLED=false
HUNTER_TRAIL_SHADOW_LOG=true
HUNTER_TRAIL_ARM_PCT=2                # arm trail когда unrealized% пересёк +X%
HUNTER_TRAIL_GIVE_BACK_PCT=30         # close если откатили ≥Y% от пика

# ── Hunter Long (Iter E.1) — Long-after-dump, заняла слот после Fade soft-kill ──
# Зеркало Hunter SHORT: триггер на резкий ДАМП ≥X%/2мин → лонг с SL ниже / TP выше.
# Default OFF — включить только когда готовы наблюдать в PAPER.
# PROD путь будет в Iter E.3 (отдельный gate HUNTER_LONG_PROD_ENABLED).
HUNTER_LONG_ENABLED=false
HUNTER_LONG_PROD_ENABLED=false        # Iter E.3: реальные ордера на HL для LONG-ветки. Двойной gate как у Hunter SHORT.
HUNTER_LONG_DUMP_PCT=3.0              # порог дампа за 2мин (%, по модулю)
HUNTER_LONG_SL_PCT=2.0                # SL: entry × (1 − SL%/100) — ниже entry
HUNTER_LONG_TP_PCT=3.0                # TP: entry × (1 + TP%/100) — выше entry
HUNTER_LONG_TREND_LOOKBACK_MIN=15     # окно anti-trend filter
HUNTER_LONG_TREND_MAX_DROP_PCT=6      # макс падение за это окно — глубже = устойчивый downtrend (агрессивнее, чем Hunter SHORT с 8%)
HUNTER_LONG_POST_SL_COOLDOWN_MIN=60   # после SL не возвращаемся N мин (длиннее Hunter SHORT — у дампов выше риск повтора)
HUNTER_LONG_TIME_STOP_MIN=60          # позиция закрывается по market если за N мин ни SL ни TP
# Iter E.2: trailing TP (PAPER, зеркало HUNTER_TRAIL_*). ARM_PCT < HUNTER_LONG_TP_PCT обязательно.
# SHADOW_LOG=true даёт "would-have-trailed" события даже при ENABLED=false — для оценки эффекта.
HUNTER_LONG_TRAIL_ENABLED=false
HUNTER_LONG_TRAIL_SHADOW_LOG=true
HUNTER_LONG_TRAIL_ARM_PCT=2           # arm trail когда unrealized% пересёк +X% (LONG: цена выше entry на X%)
HUNTER_LONG_TRAIL_GIVE_BACK_PCT=30    # close если откатили ≥Y% от пика

# ── Risk management ──────────────────────────────
MAX_DRAWDOWN_PCT=10           # стоп открытий при -X% от стартового equity сессии
CB_MAX_LOSSES=3               # circuit breaker: макс убытков подряд в окне 1ч
CB_PAUSE_HOURS=2              # пауза после срабатывания circuit breaker

# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
SILENT_START_HOUR=22           # начало тихого режима (час по серверному времени)
SILENT_END_HOUR=9              # конец тихого режима

# ── Binance (read-only, для Tax Collector / PIT-38) ──
# Если оба пустые — модуль taxCollector тихо отключается, бот работает как раньше.
# Ключи нужны только с правом READ. НЕ давай право Trading/Withdraw.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Tax Manager (push outbox в централизованный ledger) ──
# Если TAX_HMAC_SECRET пустой — pusher тихо отключается, бот работает как раньше.
# TAX_HMAC_SECRET — это sha256-hex от plaintext (см. INTEGRATION.md шаг 8).
TAX_MANAGER_URL=http://tax-api:3020
TAX_PROJECT=hl-paper-scanner
TAX_HMAC_SECRET=

# ── Логирование ──────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
